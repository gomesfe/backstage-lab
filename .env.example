# Copie para .env e ajuste. Lido pelo docker compose e pelo backend.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=backstage
POSTGRES_PASSWORD=backstage

# PAT do GitHub: necessário para o catálogo ler repos e para o template
# "Tela estática" abrir PR. Escopos: repo, workflow.
GITHUB_TOKEN=

# OAuth App do GitHub, para o login do portal.
# Crie em https://github.com/settings/developers > New OAuth App
#   Homepage URL:               http://localhost:3000
#   Authorization callback URL: http://localhost:7007/api/auth/github/handler/frame
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=
