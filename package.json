{
  "name": "root",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "22 || 24"
  },
  "scripts": {
    "start": "yarn pages:sync && yarn templates:sync && node scripts/start-dev.mjs",
    "start:backend": "yarn workspace backend start",
    "start:app": "yarn workspace app start",
    "start:together": "yarn pages:sync && yarn templates:sync && backstage-cli repo start",
    "build:hosted": "yarn pages:sync && yarn templates:sync && yarn tsc && yarn workspace app build",
    "serve:tailscale": "node scripts/serve-tailscale.mjs",
    "start:sqlite": "node scripts/use-sqlite.mjs && yarn start",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "pages:new": "node scripts/new-static-page.mjs",
    "pages:sync": "node scripts/sync-static-pages.mjs",
    "pages:preview": "node scripts/preview-static-page.mjs",
    "templates:sync": "node scripts/generate-aws-templates.mjs",
    "templates:check": "node scripts/generate-aws-templates.mjs --check",
    "build:backend": "yarn workspace backend build",
    "build:all": "yarn pages:sync && yarn templates:sync && backstage-cli repo build --all",
    "build-image": "yarn workspace backend build-image",
    "tsc": "tsc",
    "tsc:full": "tsc --skipLibCheck false --incremental false",
    "clean": "backstage-cli repo clean",
    "test": "backstage-cli repo test",
    "test:all": "backstage-cli repo test --coverage",
    "test:e2e": "playwright test",
    "fix": "backstage-cli repo fix",
    "lint": "backstage-cli repo lint --since origin/master",
    "lint:all": "backstage-cli repo lint",
    "prettier:check": "prettier --check .",
    "new": "backstage-cli new",
    "db:pg": "node scripts/use-sqlite.mjs --off"
  },
  "backstage": {
    "cli": {
      "new": {
        "globals": {
          "license": "UNLICENSED"
        }
      }
    }
  },
  "workspaces": [
    "packages/*",
    "plugins/*"
  ],
  "devDependencies": {
    "@backstage/cli": "^0.36.6",
    "@backstage/cli-defaults": "^0.1.6",
    "@backstage/e2e-test-utils": "^0.1.2",
    "@jest/environment-jsdom-abstract": "~30.2.0",
    "@playwright/test": "^1.32.3",
    "@types/jest": "^30.0.0",
    "jest": "~30.2.0",
    "jsdom": "^27.1.0",
    "node-gyp": "^10.0.0",
    "prettier": "^2.3.2",
    "typescript": "~5.8.0"
  },
  "resolutions": {
    "@types/react": "^18",
    "@types/react-dom": "^18"
  },
  "prettier": "@backstage/cli/config/prettier",
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "packageManager": "yarn@4.13.0"
}
